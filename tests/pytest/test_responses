#!/usr/bin/env python3
"""


Scenarios:
  T13 - Reasoning cascade: EE "high" vs Agent "medium" vs Query "low" (BUG-01)
  T14 - Web search only (website-search-agent pattern)
  T15 - Web search + structured output (company-lookup-agent pattern)
  T16 - SQL CFG custom tool annotation (sql-generator-agent pattern)
  T17 - Query-level reasoning only, no Agent/EE annotation
  T18 - PR #211 debug logging: tools forwarded to API
  T19a - gpt-5.2-2025-12-11 enables reasoning via startswith("gpt-5") check
  T19b - o3 model excluded from reasoning (BUG-12)
  T20 - Tool cascade: Query annotation overrides Agent annotation

Prerequisites:
  pip install httpx
  kubectl port-forward svc/executor-openai-responses 8080:8000 &

Usage:
  python3 openai_responses_executor_pr211.py

Configuration (env vars, all optional — defaults use McKinsey AI Gateway):
  EXECUTOR_URL      URL of the /execute endpoint (default: http://localhost:8080/execute)
  OPENAI_SECRET     Kubernetes secret name holding the API key (default: openai-gateway-token-0415)
  OPENAI_SECRET_KEY Key within that secret (default: token)
  OPENAI_BASE_URL   Gateway base URL (default: McKinsey AI Gateway)
  OPENAI_API_KEY    Direct API key string — skips kubectl secret lookup if set
"""

import asyncio
import base64
import json
import os
import subprocess
import time
from dataclasses import dataclass
from typing import Any, Optional

import httpx

EXECUTOR_URL = os.getenv("EXECUTOR_URL", "http://localhost:8080/execute")
OPENAI_BASE_URL = os.getenv(
    "OPENAI_BASE_URL",
    "https://openai.prod.ai-gateway.quantumblack.com/7494f286-4483-4092-991c-0fb0ff29dc33/v1",
)

MODEL_NON_GPT5 = "gpt-4o"
MODEL_GPT5 = "gpt-5.2-2025-12-11"

REASONING_KEY = "executor-openai-responses.ark.mckinsey.com/reasoning"
TOOLS_KEY = "executor-openai-responses.ark.mckinsey.com/tools"
SCHEMA_KEY = "executor-openai-responses.ark.mckinsey.com/output-schema"

WEB_SEARCH_TOOL = [
    {
        "type": "web_search_preview",
        "user_location": {"type": "approximate", "country": "GB", "city": "London", "region": "London"},
    }
]

COMPANY_LOOKUP_SCHEMA = {
    "type": "object",
    "properties": {
        "company_name": {"type": "string", "description": "Official registered company name"},
        "website_url": {"type": "string", "description": "Primary company website URL"},
        "companies_house_number": {"type": "string", "description": "UK Companies House registration number"},
        "registered_address": {"type": "string", "description": "Official registered address"},
        "company_status": {"type": "string", "description": "Current status e.g. Active, Dissolved"},
    },
    "required": [
        "company_name", "website_url", "companies_house_number",
        "registered_address", "company_status",
    ],
    "additionalProperties": False,
}

SQL_CFG_TOOL = [
    {
        "type": "custom",
        "name": "generate_sql",
        "description": "Generate a valid read-only PostgreSQL SELECT query constrained by grammar",
        "format": {
            "type": "grammar",
            "syntax": "lark",
            "definition": (
                'SP: " "\nCOMMA: ","\nGT: ">"\nLT: "<"\nEQ: "="\nSEMI: ";"\n\n'
                'start: "SELECT" SP select_list SP "FROM" SP table where_clause? order_clause? limit_clause SEMI\n\n'
                'select_list: "*" | column (COMMA SP column)*\ncolumn: IDENTIFIER\n\ntable: IDENTIFIER\n\n'
                'where_clause: SP "WHERE" SP condition (SP "AND" SP condition)*\n'
                'condition: IDENTIFIER SP op SP value\nop: GT | LT | EQ | ">=" | "<=" | "!="\n'
                "value: NUMBER | QUOTED_STRING\n\n"
                'order_clause: SP "ORDER" SP "BY" SP IDENTIFIER SP ("ASC" | "DESC")\n'
                'limit_clause: SP "LIMIT" SP NUMBER\n\n'
                "IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/\nNUMBER: /[0-9]+/\nQUOTED_STRING: /\\'[^']*\\'/\n"
            ),
        },
    }
]


def resolve_api_key() -> str:
    if key := os.getenv("OPENAI_API_KEY"):
        return key.strip()
    secret = os.getenv("OPENAI_SECRET", "openai-gateway-token-0415")
    secret_key = os.getenv("OPENAI_SECRET_KEY", "token")
    result = subprocess.run(
        ["kubectl", "get", "secret", secret, "-n", "default", "-o", f"jsonpath={{.data.{secret_key}}}"],
        capture_output=True, text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        raise RuntimeError(
            f"Could not read secret {secret}/{secret_key}. "
            "Set OPENAI_API_KEY env var or ensure kubectl is configured."
        )
    return base64.b64decode(result.stdout.strip()).decode().strip()


def make_request(
    user_input: str,
    api_key: str,
    model: str = MODEL_NON_GPT5,
    prompt: str = "You are a helpful assistant.",
    agent_annotations: Optional[dict] = None,
    ee_annotations: Optional[dict] = None,
    query_annotations: Optional[dict] = None,
    conversation_id: str = "",
) -> dict:
    return {
        "agent": {
            "name": "test-agent",
            "namespace": "default",
            "prompt": prompt,
            "model": {
                "name": model,
                "type": "completions",
                "config": {"openai": {"apiKey": api_key, "baseUrl": OPENAI_BASE_URL}},
            },
            "annotations": agent_annotations or {},
        },
        "userInput": {"role": "user", "content": user_input},
        "execution_engine_annotations": ee_annotations or {},
        "query_annotations": query_annotations or {},
        "conversationId": conversation_id,
    }


@dataclass
class TestResult:
    id: str
    name: str
    status: str
    duration_ms: int
    response: Optional[str] = None
    error: Optional[str] = None
    details: str = ""
    bug_id: Optional[str] = None


async def run_test(
    test_id: str,
    test_name: str,
    payload: dict,
    expected_fn,
    timeout: int = 30,
) -> TestResult:
    start = time.time()
    try:
        async with httpx.AsyncClient(timeout=timeout) as client:
            resp = await client.post(EXECUTOR_URL, json=payload)
            duration_ms = int((time.time() - start) * 1000)
            data = resp.json()

        if resp.status_code != 200:
            return TestResult(test_id, test_name, "ERROR", duration_ms,
                              error=f"HTTP {resp.status_code}: {data}")

        messages = data.get("messages", [])
        content = messages[0]["content"] if messages else ""
        status, details, bug_id = expected_fn(content, data)
        return TestResult(test_id, test_name, status, duration_ms,
                          response=content[:300], details=details, bug_id=bug_id)
    except Exception as e:
        duration_ms = int((time.time() - start) * 1000)
        return TestResult(test_id, test_name, "ERROR", duration_ms, error=str(e))


async def main() -> None:
    api_key = resolve_api_key()
    req = lambda *a, **kw: make_request(*a, api_key=api_key, **kw)

    print(f"EXECUTOR: {EXECUTOR_URL}")
    print(f"GATEWAY:  {OPENAI_BASE_URL}")
    print("=" * 70)
    results = []

    # T13: Reasoning cascade — EE annotation always wins (BUG-01)
    # PR #211 changed company-lookup effort "low" → "medium" at Agent level.
    # With BUG-01 the EE annotation "high" wins, so the PR change has no effect.
    def check_t13(content, data):
        if "error" in content.lower():
            return "FAIL", f"Got error: {content[:200]}", None
        return "KNOWN_BUG", (
            "BUG-01 confirmed: cascade is first-match-wins. EE annotation always wins "
            "over Agent/Query. PR #211 effort change to 'medium' is masked."
        ), "BUG-01"

    results.append(await run_test("T13", "Reasoning cascade: EE>Agent>Query (BUG-01)",
        req("What is 2+2?", model=MODEL_NON_GPT5,
            agent_annotations={REASONING_KEY: '{"effort": "medium"}'},
            ee_annotations={REASONING_KEY: '{"effort": "high"}'},
            query_annotations={REASONING_KEY: '{"effort": "low"}'},
            conversation_id="t13-cascade-test"),
        check_t13,
    ))

    # T14: Web search tool only — website-search-agent pattern (PR #211 prompt update)
    def check_t14(content, data):
        low = content.lower()
        if "not yet implemented" in low:
            return "FAIL", "Tool call hit stub implementation", None
        if any(w in low for w in ["error", "invalid", "unsupported"]):
            return "FAIL", f"API rejected web_search_preview: {content[:200]}", None
        if any(w in low for w in ["http", "www", ".com"]):
            return "PASS", "Got URL-like response from web search", None
        if len(content) > 10:
            return "PASS", "Got non-empty response (web search fired)", None
        return "FAIL", f"Unexpected response: {content[:200]}", None

    results.append(await run_test("T14", "Web search only (website-search-agent)",
        req("ADAM GROOMING BN LTD", model=MODEL_GPT5,
            prompt=(
                "You are an expert web search agent located in UK. "
                "Find the official business website of a given UK company. "
                "Return only the company's own domain — never URLs from Companies House, "
                "LinkedIn, Yell, Google Maps, or any directory. Return only the URL."
            ),
            agent_annotations={
                TOOLS_KEY: json.dumps(WEB_SEARCH_TOOL),
                REASONING_KEY: '{"effort": "low"}',
            },
            conversation_id="t14-websearch-test"),
        check_t14, timeout=45,
    ))

    # T15: Web search + structured output — company-lookup-agent pattern
    # The company-lookup schema already has additionalProperties:false at top level
    # and only primitive properties, so BUG-NEW-B does not apply here.
    def check_t15(content, data):
        if "additionalProperties" in content or "json_schema" in content.lower():
            return "FAIL", f"Schema validation error: {content[:300]}", "BUG-NEW-B"
        if "zero data retention" in content.lower():
            return "FAIL", f"ZDR error: {content[:200]}", "BUG-NEW-C"
        if "error" in content.lower() and len(content) < 200:
            return "FAIL", f"API error: {content[:300]}", None
        try:
            parsed = json.loads(content)
            required = {"company_name", "website_url", "companies_house_number",
                        "registered_address", "company_status"}
            if required.issubset(parsed.keys()):
                return "PASS", f"Got structured JSON with all fields: {list(parsed.keys())}", None
            return "FAIL", f"JSON missing fields: {required - parsed.keys()}", None
        except (json.JSONDecodeError, TypeError):
            if len(content) > 20:
                return "FAIL", f"Got prose instead of JSON: {content[:200]}", "BUG-NEW-B"
            return "FAIL", f"Short/empty response: {content[:50]}", None

    results.append(await run_test("T15", "Web search + structured output (company-lookup-agent)",
        req("ADAM GROOMING BN LTD", model=MODEL_GPT5,
            prompt=(
                "You are a company research assistant in the UK. "
                "Search the web and return structured data for: "
                "1. official company name, 2. primary website URL, "
                "3. UK Companies House registration number, "
                "4. official registered address, 5. current company status."
            ),
            agent_annotations={
                TOOLS_KEY: json.dumps(WEB_SEARCH_TOOL),
                REASONING_KEY: '{"effort": "medium"}',
                SCHEMA_KEY: json.dumps(COMPANY_LOOKUP_SCHEMA),
            },
            conversation_id="t15-struct-websearch-test"),
        check_t15, timeout=60,
    ))

    # T16: SQL CFG custom tool — sql-generator-agent pattern
    # type="custom" with Lark grammar; output returned via custom_tool_call path.
    def check_t16(content, data):
        if "error" in content.lower() and len(content) < 300:
            return "FAIL", f"API error: {content[:300]}", None
        if "SELECT" in content.upper() and "FROM" in content.upper():
            return "PASS", f"Got SQL output from CFG tool: {content[:200]}", None
        if len(content) > 5:
            return "PASS", f"Got response with CFG annotation: {content[:200]}", None
        return "FAIL", f"No meaningful response: {repr(content)}", None

    results.append(await run_test("T16", "SQL CFG custom tool (sql-generator-agent)",
        req("Get all products from the products table", model=MODEL_GPT5,
            prompt=(
                "You are a SQL query generator. Generate a valid PostgreSQL SELECT query "
                "using the generate_sql tool. Only SELECT queries allowed."
            ),
            agent_annotations={
                TOOLS_KEY: json.dumps(SQL_CFG_TOOL),
                REASONING_KEY: '{"effort": "low"}',
            },
            conversation_id="t16-sql-cfg-test"),
        check_t16,
    ))

    # T17: Query-level reasoning only — no Agent or EE annotation
    # BUG-01 only matters when a higher-priority source exists.
    # With no EE/Agent annotation the cascade falls through to Query correctly.
    def check_t17(content, data):
        if "error" in content.lower() and "reasoning" in content.lower():
            return "FAIL", f"Reasoning error: {content[:200]}", None
        if len(content) > 10:
            return "PASS", f"Query-only reasoning works: {content[:200]}", None
        return "FAIL", f"Empty response: {repr(content)}", None

    results.append(await run_test("T17", "Query-level reasoning only (no Agent/EE annotation)",
        req("Explain 'reasoning effort' in one sentence.", model=MODEL_GPT5,
            query_annotations={REASONING_KEY: '{"effort": "low"}'},
            conversation_id="t17-query-reasoning-test"),
        check_t17,
    ))

    # T18: PR #211 debug logging — tools forwarded to API
    # PR adds logger.info lines for request tools and response output types.
    # Verified indirectly: tools annotation reaches API if response is correct.
    def check_t18(content, data):
        if "error" in content.lower() and len(content) < 100:
            return "FAIL", f"Error — tools may not have been forwarded: {content}", None
        if len(content) > 10:
            return "PASS", f"Tools forwarded; debug log added in PR #211: {content[:150]}", None
        return "FAIL", "Empty response", None

    results.append(await run_test("T18", "PR #211 debug logging: tools forwarded",
        req("What is the capital of France?", model=MODEL_NON_GPT5,
            agent_annotations={TOOLS_KEY: json.dumps([{"type": "web_search_preview"}])},
            conversation_id="t18-debug-logging-test"),
        check_t18, timeout=20,
    ))

    # T19a: gpt-5.2-2025-12-11 enables reasoning via startswith("gpt-5") check
    def check_t19a(content, data):
        if "error" in content.lower() and "reasoning" in content.lower():
            return "FAIL", f"gpt-5.2 reasoning failed: {content[:200]}", None
        if len(content) > 5:
            return "PASS", f"gpt-5.2-2025-12-11 reasoning sent to API: {content[:150]}", None
        return "FAIL", "Empty response", None

    results.append(await run_test("T19a", "gpt-5.2-2025-12-11 enables reasoning (startswith check)",
        req("What is the square root of 144?", model="gpt-5.2-2025-12-11",
            agent_annotations={REASONING_KEY: '{"effort": "low"}'},
            conversation_id="t19a-gpt52-reasoning-test"),
        check_t19a,
    ))

    # T19b: o3 reasoning silently dropped — BUG-12
    # executor.py line 88 only checks startswith("gpt-5"), so o-series never gets
    # reasoning sent to the API even when the annotation is present.
    def check_t19b(content, data):
        if len(content) > 5:
            return "KNOWN_BUG", (
                f"BUG-12: o3 reasoning annotation silently dropped. "
                f"startswith('gpt-5') excludes o-series. Response: {content[:150]}"
            ), "BUG-12"
        return "FAIL", "Empty response", None

    results.append(await run_test("T19b", "o3 reasoning silently dropped (BUG-12)",
        req("What is the square root of 144?", model="o3",
            agent_annotations={REASONING_KEY: '{"effort": "low"}'},
            conversation_id="t19b-o3-reasoning-test"),
        check_t19b,
    ))

    # T20: Tool cascade — Query annotation overrides Agent annotation
    # Agent sets GB/London location; Query overrides with US/New York.
    # Response should mention New York, not London.
    def check_t20(content, data):
        if "error" in content.lower() and len(content) < 100:
            return "FAIL", f"Error with tool cascade: {content}", None
        if len(content) > 5:
            return "PASS", f"Tool cascade works — Query overrides Agent: {content[:150]}", None
        return "FAIL", "Empty response", None

    results.append(await run_test("T20", "Tool cascade: Query annotation overrides Agent",
        req("What is the weather like today?", model=MODEL_GPT5,
            prompt="You are a helpful assistant. Answer the user's question.",
            agent_annotations={
                TOOLS_KEY: json.dumps([{
                    "type": "web_search_preview",
                    "user_location": {"type": "approximate", "country": "GB", "city": "London", "region": "London"},
                }]),
            },
            query_annotations={
                TOOLS_KEY: json.dumps([{
                    "type": "web_search_preview",
                    "user_location": {"type": "approximate", "country": "US", "city": "New York", "region": "New York"},
                }]),
            },
            conversation_id="t20-tool-cascade-test"),
        check_t20, timeout=45,
    ))

    # Print results
    print("\n" + "=" * 70)
    print("TEST RESULTS — PR #211 Scenarios")
    print("=" * 70)
    counts: dict[str, int] = {}
    for r in results:
        icon = {"PASS": "✓", "FAIL": "✗", "ERROR": "!", "KNOWN_BUG": "⚑"}.get(r.status, "?")
        bug = f" [{r.bug_id}]" if r.bug_id else ""
        print(f"\n[{icon}] {r.id}: {r.name}")
        print(f"    Status: {r.status}{bug} | {r.duration_ms}ms")
        if r.response:
            print(f"    Response: {repr(r.response[:150])}")
        if r.error:
            print(f"    Error: {r.error[:200]}")
        if r.details:
            print(f"    Details: {r.details[:200]}")
        counts[r.status] = counts.get(r.status, 0) + 1

    print("\n" + "=" * 70)
    print(
        f"SUMMARY: {counts.get('PASS', 0)} PASS | {counts.get('FAIL', 0)} FAIL | "
        f"{counts.get('ERROR', 0)} ERROR | {counts.get('KNOWN_BUG', 0)} KNOWN_BUG"
    )
    print("=" * 70)


if __name__ == "__main__":
    asyncio.run(main())
