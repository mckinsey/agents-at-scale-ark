#!/usr/bin/env python3
"""Check benchmark results against a scenario from performance-thresholds.yaml.

Usage: calc-check-thresholds <thresholds.yaml> <scenario-name> <results.json>
Exit 0 if all assertions pass, exit 1 otherwise.
"""
import json, sys, yaml

if len(sys.argv) != 4:
    print(f"Usage: {sys.argv[0]} <thresholds.yaml> <scenario-name> <results.json>", file=sys.stderr)
    sys.exit(2)

thresholds_path, scenario_name, results_path = sys.argv[1], sys.argv[2], sys.argv[3]

with open(thresholds_path) as f:
    thresholds = yaml.safe_load(f)

scenario = None
for s in thresholds["storage_backends"]:
    if s["name"] == scenario_name:
        scenario = s
        break

if scenario is None:
    print(f"Scenario '{scenario_name}' not found in {thresholds_path}", file=sys.stderr)
    sys.exit(2)

with open(results_path) as f:
    results = json.load(f)

assertions = scenario["assertions"]
failures = []

for r in results["results"]:
    if r["operation"] == "create":
        errors = r["errors"]
        p99_ms = r["latency_p99_ns"] / 1e6

        max_errors = assertions.get("create_errors")
        if max_errors is not None and errors > max_errors:
            failures.append(f"create errors: {errors} > {max_errors}")

        max_p99 = assertions.get("create_p99_ms")
        if max_p99 is not None and p99_ms > max_p99:
            failures.append(f"create p99: {p99_ms:.1f}ms > {max_p99}ms")

        print(f"  create: errors={errors} p99={p99_ms:.1f}ms")

if failures:
    for f in failures:
        print(f"FAIL: {f}")
    sys.exit(1)
else:
    print("PASS")
