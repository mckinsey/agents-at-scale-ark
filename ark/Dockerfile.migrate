FROM migrate/migrate:v4.20.1

LABEL org.opencontainers.image.title="ark-controller-migrate" \
      org.opencontainers.image.description="Applies PostgreSQL schema migrations for the ark aggregated apiserver using golang-migrate" \
      org.opencontainers.image.source="https://github.com/mckinsey/agents-at-scale-ark" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="McKinsey & Company"

COPY --chown=root:root --chmod=555 internal/storage/postgresql/migrations /migrations

USER 65534:65534
